# ==============================================================================
# TEMPLATE ENVIRONMENT VARIABLES - AKAR (Aspirasi, Keterbukaan, Aksi, Realisasi)
# ==============================================================================
# Salin berkas ini ke '.env' dan isi dengan kredensial lokal/lingkungan Anda.
# CATATAN: Kunci rahasia (SERVICE_ROLE_KEY & OPENROUTER_API_KEY) HANYA untuk server
# dan TIDAK BOLEH dikirimkan ke peramban atau di-commit ke repositori git.
# ==============================================================================

# URL Aplikasi Publik (Frontend)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Basis Data PostgreSQL (Supabase / Lokal)
# DATABASE_URL: Koneksi pooling (Transaction/Session Pooler Port 5432/6543)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# DIRECT_URL: Koneksi langsung untuk Prisma Migrate (tanpa pooler)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://akar-desa-demo.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="dummy-anon-key-for-local-development"
SUPABASE_SERVICE_ROLE_KEY="dummy-service-role-key-never-expose-to-browser"

# AI OpenRouter Engine (OpenAI SDK Compliant)
OPENROUTER_API_KEY="sk-or-v1-dummy-openrouter-api-key"
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"
OPENROUTER_FALLBACK_MODEL="deepseek/deepseek-chat"

# Ambang Batas Kemiripan Teks Proposal (Prinsip pg_trgm N-Gram Jaccard)
SIMILARITY_THRESHOLD=0.80

# Kunci Garam Hash NIK (FR-ID1 - Privasi Warga)
NIK_HASH_SALT="akar-karangsari-demo-salt-2026"

# Lingkungan Runtime
NODE_ENV="development"
