generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

// ================= ENUMERASI ================= 
enum Peran {
  WARGA
  PERANGKAT
  PENGAWAS
  ADMIN
}

enum StatusAkun {
  MENUNGGU
  AKTIF
  DITOLAK
  DINONAKTIFKAN
}

enum KelasProyek {
  KECIL
  MENENGAH
  BESAR
}

enum Jalur {
  SAYEMBARA
  VENDOR
}

enum StatusProyek {
  PEMATANGAN
  TENDER_DIBUKA
  PEMILIHAN_VENDOR
  SELEKSI
  VERIFIKASI_KOMPETENSI
  MASA_SANGGAH
  PENGERJAAN
  SELESAI
  DIBATALKAN
}

enum StatusAnalisis {
  MENUNGGU
  BERHASIL
  GAGAL
}

enum JenisFlag {
  TEKS
  ANGGOTA
}

enum KeputusanFlag {
  BELUM
  WAJAR
  KLARIFIKASI
  TIDAK_SAH
}

enum StatusSanggah {
  TERBUKA
  DITANGGAPI
}

enum JenisEntri {
  PENERIMAAN
  KOMITMEN
  PEMBAYARAN
  KOREKSI
}

enum LevelAkun {
  BIDANG
  SUB_BIDANG
  KEGIATAN
}

enum JenisBelanja {
  PEGAWAI
  BARANG_JASA
  MODAL
  TAK_TERDUGA
}

enum StatusVerifikasi {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

// ================= MODEL PENGGUNA & AUDIT ================= 

model Pengguna {
  id               String            @id @default(cuid())
  authId           String            @unique
  nama             String
  email            String            @unique
  peran            Peran             @default(WARGA)
  statusAkun       StatusAkun        @default(MENUNGGU)
  desaId           String
  rtRw             String?
  kontak           String?
  setujuSyaratPada DateTime?
  createdAt        DateTime          @default(now())

  desa             Desa              @relation(fields: [desaId], references: [id])
  kelompokDipimpin Kelompok[]
  anggotaKelompok  AnggotaKelompok[]
  penilaian        VerifikasiKompetensi[]
  keputusan        Keputusan[]
  sanggahan        Sanggahan[]
  entriDicatat     EntriKas[]        @relation("Pencatat")
  verifikasiKas    VerifikasiEntri[] @relation("PemverifikasiKas")
  audit            AuditLog[]

  @@index([desaId])
}

model AuditLog {
  id        String    @id @default(cuid())
  aktorId   String?
  aksi      String
  entitas   String
  entitasId String
  sebelum   Json?
  sesudah   Json?
  waktu     DateTime  @default(now())

  aktor     Pengguna? @relation(fields: [aktorId], references: [id])

  @@index([entitas, entitasId])
}

// ================= MODEL INTI T1 ================= 

model Desa {
  id          String        @id @default(cuid())
  nama        String
  kecamatan   String
  kabupaten   String
  tahun       Int           @default(0)
  pagu        BigInt
  pagukdmp    BigInt        @default(0)
  konfigurasi Json?
  createdAt   DateTime      @default(now())
  proyek      Proyek[]
  pengguna    Pengguna[]
  sumberDana  SumberDana[]
  posAnggaran PosAnggaran[]
  entriKas    EntriKas[]
}

model Proyek {
  id               String          @id @default(cuid())
  desaId           String
  posAnggaranId    String?
  judul            String
  deskripsi        String
  lokasi           String
  pagu             BigInt
  kelas            KelasProyek
  jalur            Jalur?
  alasanJalur      String?
  status           StatusProyek    @default(PEMATANGAN)
  tenggatProposal  DateTime?
  akhirMasaSanggah DateTime?
  syaratLokalMin   Int             @default(70)
  durasiMin        Int             @default(30)
  durasiMax        Int             @default(90)
  createdAt        DateTime        @default(now())

  desa             Desa            @relation(fields: [desaId], references: [id])
  posAnggaran      PosAnggaran?    @relation(fields: [posAnggaranId], references: [id])
  rab              RabItem[]
  proposal         Proposal[]
  flag             FlagKemiripan[]
  keputusan        Keputusan?
  termin           Termin[]
  entriKas         EntriKas[]

  @@index([desaId, status])
}

model RabItem {
  id          String @id @default(cuid())
  proyekId    String
  uraian      String
  volume      Float
  satuan      String
  hargaSatuan BigInt

  proyek Proyek @relation(fields: [proyekId], references: [id])

  @@index([proyekId])
}

model Kelompok {
  id        String   @id @default(cuid())
  nama      String
  ketuaId   String
  createdAt DateTime @default(now())

  ketua    Pengguna          @relation(fields: [ketuaId], references: [id])
  anggota  AnggotaKelompok[]
  proposal Proposal[]
}

model AnggotaKelompok {
  id         String   @id @default(cuid())
  kelompokId String
  penggunaId String?
  nama       String?
  rtRw       String?
  nikHash    String?
  ketua      Boolean  @default(false)

  kelompok Kelompok  @relation(fields: [kelompokId], references: [id])
  pengguna Pengguna? @relation(fields: [penggunaId], references: [id])

  @@index([nikHash])
  @@index([kelompokId])
}

model Proposal {
  id             String         @id @default(cuid())
  proyekId       String
  kelompokId     String
  penawaran      BigInt
  durasiHari     Int
  tenagaTotal    Int
  tenagaLokal    Int
  narasiMetode   String
  narasiJadwal   String
  narasiRisiko   String
  dokumen        String[]
  kelengkapan    Json
  dikirimPada    DateTime       @default(now())
  statusAnalisis StatusAnalisis @default(MENUNGGU)

  proyek    Proyek          @relation(fields: [proyekId], references: [id])
  kelompok  Kelompok        @relation(fields: [kelompokId], references: [id])
  ringkasan  RingkasanAi?
  skor       Skor?
  flagA      FlagKemiripan[]        @relation("FlagA")
  flagB      FlagKemiripan[]        @relation("FlagB")
  kompetensi VerifikasiKompetensi[]
  keputusan  Keputusan?
  sanggahan  Sanggahan[]

  @@unique([proyekId, kelompokId])
  @@index([proyekId])
}

model RingkasanAi {
  id          String   @id @default(cuid())
  proposalId  String   @unique
  json        Json
  model       String
  versiPrompt String
  dibuatPada  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id])
}

model Skor {
  id         String   @id @default(cuid())
  proposalId String   @unique
  total      Int
  rincian    Json
  flags      Json
  versiBobot String
  dibuatPada DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id])
}

model FlagKemiripan {
  id          String        @id @default(cuid())
  proyekId    String
  proposalAId String
  proposalBId String
  nilai       Float
  jenis       JenisFlag
  keputusan   KeputusanFlag @default(BELUM)
  catatan     String?

  proyek    Proyek   @relation(fields: [proyekId], references: [id])
  proposalA Proposal @relation("FlagA", fields: [proposalAId], references: [id])
  proposalB Proposal @relation("FlagB", fields: [proposalBId], references: [id])

  @@index([proyekId])
}

model VerifikasiKompetensi {
  id          String   @id @default(cuid())
  proposalId  String
  penilaiId   String
  nilaiRubrik Json
  catatan     String?
  dibuatPada  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id])
  penilai  Pengguna @relation(fields: [penilaiId], references: [id])

  @@index([proposalId])
}

model Keputusan {
  id                    String   @id @default(cuid())
  proyekId              String   @unique
  proposalId            String   @unique
  alasan                String
  alasanTambahan        String?
  dibuatOlehId          String
  bukanPeringkatTeratas Boolean  @default(false)
  dibuatPada            DateTime @default(now())

  proyek     Proyek   @relation(fields: [proyekId], references: [id])
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  dibuatOleh Pengguna @relation(fields: [dibuatOlehId], references: [id])
}

model Sanggahan {
  id         String        @id @default(cuid())
  proposalId String
  penggunaId String
  isi        String
  tanggapan  String?
  status     StatusSanggah @default(TERBUKA)
  dibuatPada DateTime      @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id])
  pengguna Pengguna @relation(fields: [penggunaId], references: [id])

  @@index([proposalId])
}

// ================= MODEL BUKU KAS PUBLIK (BAGIAN 43) ================= 

model SumberDana {
  id        String        @id @default(cuid())
  desaId    String
  nama      String
  tahun     Int
  pagu      BigInt

  desa      Desa          @relation(fields: [desaId], references: [id])
  pos       PosAnggaran[]
  entri     EntriKas[]

  @@index([desaId, tahun])
}

model RefAkun {
  id            String        @id @default(cuid())
  kode          String
  uraian        String
  level         LevelAkun
  parentId      String?
  kodeSiskeudes String?
  sensitif      Boolean       @default(false)

  parent        RefAkun?      @relation("AkunInduk", fields: [parentId], references: [id])
  anak          RefAkun[]     @relation("AkunInduk")
  pos           PosAnggaran[]

  @@unique([level, kode])
}

model PosAnggaran {
  id           String       @id @default(cuid())
  desaId       String
  tahun        Int
  akunId       String
  sumberDanaId String
  jenisBelanja JenisBelanja
  uraian       String
  anggaran     BigInt
  sensitif     Boolean      @default(false)

  desa         Desa         @relation(fields: [desaId], references: [id])
  akun         RefAkun      @relation(fields: [akunId], references: [id])
  sumberDana   SumberDana   @relation(fields: [sumberDanaId], references: [id])
  proyek       Proyek[]
  entri        EntriKas[]

  @@index([desaId, tahun])
}

model Termin {
  id       String     @id @default(cuid())
  proyekId String
  tahap    Int
  nilai    BigInt
  terbuka  Boolean    @default(false)

  proyek   Proyek     @relation(fields: [proyekId], references: [id])
  entriKas EntriKas[]

  @@unique([proyekId, tahap])
}

model EntriKas {
  id                 String            @id @default(cuid())
  desaId             String
  nomorUrut          Int
  jenis              JenisEntri
  jumlah             BigInt
  tanggal            DateTime
  uraian             String
  sumberDanaId       String?
  posId              String?
  proyekId           String?
  terminId           String?
  koreksiDariId      String?
  penerima           String?
  penerimaDisamarkan Boolean           @default(true)
  buktiUrls          String[]
  pencatatId         String
  hashSebelumnya     String?
  hash               String            @unique
  dibuatPada         DateTime          @default(now())

  desa               Desa              @relation(fields: [desaId], references: [id])
  sumberDana         SumberDana?       @relation(fields: [sumberDanaId], references: [id])
  pos                PosAnggaran?      @relation(fields: [posId], references: [id])
  proyek             Proyek?           @relation(fields: [proyekId], references: [id])
  termin             Termin?           @relation(fields: [terminId], references: [id])
  koreksiDari        EntriKas?         @relation("Koreksi", fields: [koreksiDariId], references: [id])
  koreksi            EntriKas[]        @relation("Koreksi")
  pencatat           Pengguna          @relation("Pencatat", fields: [pencatatId], references: [id])
  verifikasi         VerifikasiEntri[]

  @@unique([desaId, nomorUrut])
  @@index([desaId, jenis])
  @@index([proyekId])
}

model VerifikasiEntri {
  id         String           @id @default(cuid())
  entriId    String
  pengawasId String
  keputusan  StatusVerifikasi
  catatan    String?
  waktu      DateTime         @default(now())

  entri      EntriKas         @relation(fields: [entriId], references: [id])
  pengawas   Pengguna         @relation("PemverifikasiKas", fields: [pengawasId], references: [id])

  @@index([entriId])
}
